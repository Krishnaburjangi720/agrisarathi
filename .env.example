# ===========================
# AgriSārathi Environment Variables
# ===========================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Database ---
DATABASE_URL=sqlite:///./agrisarathi.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/agrisarathi

# --- Weather API ---
# Choose one and configure:
WEATHER_API_PROVIDER=open-meteo
# WEATHER_API_KEY=your_api_key_here
# (Open-Meteo does not require an API key for basic endpoints)

# --- LLM / AI ---
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=agricultural_knowledge

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Deployment ---
# RENDER_API_KEY=your_render_key_here
# VERCEL_TOKEN=your_vercel_token_here
